@page "/query-generator"
@rendermode InteractiveServer

@using System.Text.Json
@using Tessera.Nexus.AI.Application.Contracts
@using Tessera.Nexus.AI.Application.DTOs

@inject IQueryGenerationService QueryGenerationService

<PageTitle>Query Generator</PageTitle>

<h1>AI Query Generator</h1>

<p class="text-muted">
    Generate Epicor-aware SQL using prompt templates, business rules, business knowledge, metadata grounding, and Ollama.
</p>

<div class="card mb-4">
    <div class="card-header">
        Query Request
    </div>

    <div class="card-body">
        <div class="mb-3">
            <label class="form-label" for="userQuestion">
                User Question
            </label>

            <textarea id="userQuestion"
                      class="form-control"
                      rows="4"
                      @bind="_userQuestion">
            </textarea>
        </div>

        <div class="mb-3">
            <label class="form-label" for="templateName">
                Template Name (optional)
            </label>

            <input id="templateName"
                   class="form-control"
                   @bind="_templateName"
                   placeholder="Defaults to SqlGeneration" />
        </div>

        <div class="form-check mb-3">
            <input id="executeQuery"
                   class="form-check-input"
                   type="checkbox"
                   @bind="_executeQuery" />

            <label class="form-check-label" for="executeQuery">
                Execute query after SQL is generated and validated
            </label>
        </div>

        <button class="btn btn-primary"
                type="button"
                @onclick="GenerateAsync"
                disabled="@_isLoading">
            @(_isLoading ? "Generating..." : "Generate SQL")
        </button>

        <button class="btn btn-outline-secondary ms-2"
                type="button"
                @onclick="ClearAsync"
                disabled="@_isLoading">
            Clear
        </button>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="alert alert-danger">
        @_errorMessage
    </div>
}

@if (_warnings.Count > 0)
{
    <div class="card border-warning mb-4">
        <div class="card-header bg-warning-subtle">
            SQL Validator Warnings
        </div>

        <div class="card-body">
            <ul class="mb-0">
                @foreach (var warning in _warnings)
                {
                    <li>@warning</li>
                }
            </ul>
        </div>
    </div>
}

@if (_response is not null)
{
    <div class="card mb-4">
        <div class="card-header">
            Request Summary
        </div>

        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Success</dt>
                <dd class="col-sm-9">
                    @if (_response.Success)
                    {
                        <span class="badge bg-success">True</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">False</span>
                    }
                </dd>

                <dt class="col-sm-3">SQL Validated</dt>
                <dd class="col-sm-9">
                    @if (_response.SqlValidated)
                    {
                        <span class="badge bg-success">True</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">False</span>
                    }
                </dd>

                <dt class="col-sm-3">Query Executed</dt>
                <dd class="col-sm-9">
                    @if (_executeQuery)
                    {
                        <span class="badge bg-info text-dark">Requested</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Not Requested</span>
                    }
                </dd>

                <dt class="col-sm-3">Elapsed</dt>
                <dd class="col-sm-9">@_response.ElapsedMilliseconds ms</dd>

                <dt class="col-sm-3">Processed</dt>
                <dd class="col-sm-9">@_response.ProcessedUtc</dd>

                <dt class="col-sm-3">Row Count</dt>
                <dd class="col-sm-9">
                    @(_response.RowCount.HasValue
                        ? _response.RowCount.Value.ToString()
                        : "N/A")
                </dd>

                @if (!string.IsNullOrWhiteSpace(_response.ErrorMessage))
                {
                    <dt class="col-sm-3">Error</dt>
                    <dd class="col-sm-9 text-danger">
                        @_response.ErrorMessage
                    </dd>
                }
            </dl>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header">
            Generated SQL
        </div>

        <div class="card-body">
            <pre class="mb-0">@_response.GeneratedSql</pre>
        </div>
    </div>

    @if (_resultTable is not null)
    {
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Query Results</span>
                <span class="badge bg-secondary">
                    @_resultTable.Rows.Count row(s)
                </span>
            </div>

            <div class="card-body">
                @if (_resultTable.Rows.Count == 0)
                {
                    <div class="alert alert-info mb-0">
                        Query executed successfully but returned no rows.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover table-sm">
                            <thead>
                                <tr>
                                    @foreach (var column in _resultTable.Columns)
                                    {
                                        <th>@column</th>
                                    }
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var row in _resultTable.Rows)
                                {
                                    <tr>
                                        @foreach (var column in _resultTable.Columns)
                                        {
                                            <td>@FormatCellValue(row, column)</td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_response.ResultJson))
    {
        <div class="card mb-4">
            <div class="card-header">
                Execution Result JSON
            </div>

            <div class="card-body">
                <pre style="white-space: pre-wrap;">@_response.ResultJson</pre>
            </div>
        </div>
    }

    <div class="card mb-4">
        <div class="card-header">
            Generated Prompt
        </div>

        <div class="card-body">
            <pre style="white-space: pre-wrap;">@_response.GeneratedPrompt</pre>
        </div>
    </div>
}

@code
{
    private string _userQuestion = string.Empty;
    private string _templateName = string.Empty;

    private bool _executeQuery;
    private bool _isLoading;

    private string _errorMessage = string.Empty;

    private QueryResponse? _response;
    private QueryResultTable? _resultTable;

    private readonly List<string> _warnings = new();

    private async Task GenerateAsync()
    {
        try
        {
            _isLoading = true;
            _errorMessage = string.Empty;

            _warnings.Clear();

            _response = null;
            _resultTable = null;

            if (string.IsNullOrWhiteSpace(_userQuestion))
            {
                _errorMessage = "User Question is required.";
                return;
            }

            var request = new QueryRequest
            {
                UserQuestion = _userQuestion.Trim(),
                TemplateName = string.IsNullOrWhiteSpace(_templateName)
                    ? null
                    : _templateName.Trim(),
                ExecuteQuery = _executeQuery
            };

            _response =
                await QueryGenerationService.GenerateQueryAsync(
                    request);

            if (!string.IsNullOrWhiteSpace(_response.ResultJson))
            {
                _resultTable =
                    ParseResultJson(_response.ResultJson);

                ExtractWarnings(_response.ResultJson);
            }

            if (!_response.Success)
            {
                _errorMessage =
                    _response.ErrorMessage ??
                    "An unknown error occurred.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private Task ClearAsync()
    {
        _userQuestion = string.Empty;
        _templateName = string.Empty;
        _executeQuery = false;
        _errorMessage = string.Empty;
        _response = null;
        _resultTable = null;

        _warnings.Clear();

        return Task.CompletedTask;
    }

    private void ExtractWarnings(string resultJson)
    {
        _warnings.Clear();

        try
        {
            using var document =
                JsonDocument.Parse(resultJson);

            var root = document.RootElement;

            if (!root.TryGetProperty(
                    "Warnings",
                    out var warningsElement))
            {
                return;
            }

            if (warningsElement.ValueKind != JsonValueKind.Array)
            {
                return;
            }

            foreach (var warning in warningsElement.EnumerateArray())
            {
                var value = warning.GetString();

                if (!string.IsNullOrWhiteSpace(value))
                {
                    _warnings.Add(value);
                }
            }
        }
        catch
        {
            // Ignore warning parsing errors.
        }
    }

    private static QueryResultTable? ParseResultJson(
        string resultJson)
    {
        if (string.IsNullOrWhiteSpace(resultJson))
        {
            return null;
        }

        using var document =
            JsonDocument.Parse(resultJson);

        var root =
            document.RootElement;

        var columns =
            new List<string>();

        var rows =
            new List<Dictionary<string, string?>>();

        if (root.TryGetProperty(
                "Columns",
                out var columnsElement))
        {
            foreach (var column in columnsElement.EnumerateArray())
            {
                var name = column.GetString();

                if (!string.IsNullOrWhiteSpace(name))
                {
                    columns.Add(name);
                }
            }
        }

        if (root.TryGetProperty(
                "Rows",
                out var rowsElement))
        {
            foreach (var rowElement in rowsElement.EnumerateArray())
            {
                var row =
                    new Dictionary<string, string?>(
                        StringComparer.OrdinalIgnoreCase);

                foreach (var property in rowElement.EnumerateObject())
                {
                    row[property.Name] =
                        FormatJsonValue(property.Value);
                }

                rows.Add(row);
            }
        }

        return new QueryResultTable
        {
            Columns = columns,
            Rows = rows
        };
    }

    private static string FormatCellValue(
        Dictionary<string, string?> row,
        string column)
    {
        if (!row.TryGetValue(column, out var value))
        {
            return string.Empty;
        }

        return value ?? string.Empty;
    }

    private static string? FormatJsonValue(
        JsonElement value)
    {
        return value.ValueKind switch
        {
            JsonValueKind.Null => null,
            JsonValueKind.String => FormatStringValue(
                value.GetString()),
            JsonValueKind.Number => value.ToString(),
            JsonValueKind.True => "True",
            JsonValueKind.False => "False",
            _ => value.ToString()
        };
    }

    private static string? FormatStringValue(
        string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return value;
        }

        if (DateTime.TryParse(
                value,
                out var dateValue))
        {
            return dateValue.TimeOfDay == TimeSpan.Zero
                ? dateValue.ToString("yyyy-MM-dd")
                : dateValue.ToString("yyyy-MM-dd HH:mm:ss");
        }

        return value;
    }

    private sealed class QueryResultTable
    {
        public IReadOnlyList<string> Columns { get; set; } =
            Array.Empty<string>();

        public IReadOnlyList<Dictionary<string, string?>> Rows { get; set; } =
            Array.Empty<Dictionary<string, string?>>();
    }
}