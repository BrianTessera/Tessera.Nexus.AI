@page "/query-generator"
@rendermode InteractiveServer

@using Tessera.Nexus.AI.Application.Contracts
@using Tessera.Nexus.AI.Application.DTOs

@inject IQueryGenerationService QueryGenerationService

<PageTitle>Query Generator</PageTitle>

<h1>AI Query Generator</h1>

<p class="text-muted">
    Generate Epicor-aware SQL using prompt templates, business rules, business knowledge, metadata grounding, and Ollama.
</p>

<div class="card mb-4">
    <div class="card-header">
        Query Request
    </div>

    <div class="card-body">
        <div class="mb-3">
            <label class="form-label" for="userQuestion">
                User Question
            </label>

            <textarea id="userQuestion"
                      class="form-control"
                      rows="4"
                      @bind="_userQuestion">
            </textarea>
        </div>

        <div class="mb-3">
            <label class="form-label" for="templateName">
                Template Name (optional)
            </label>

            <input id="templateName"
                   class="form-control"
                   @bind="_templateName"
                   placeholder="Defaults to SqlGeneration" />
        </div>

        <div class="form-check mb-3">
            <input id="executeQuery"
                   class="form-check-input"
                   type="checkbox"
                   @bind="_executeQuery" />

            <label class="form-check-label" for="executeQuery">
                Execute query after SQL is generated and validated
            </label>
        </div>

        <button class="btn btn-primary"
                type="button"
                @onclick="GenerateAsync"
                disabled="@_isLoading">
            @(_isLoading ? "Generating..." : "Generate SQL")
        </button>

        <button class="btn btn-outline-secondary ms-2"
                type="button"
                @onclick="ClearAsync"
                disabled="@_isLoading">
            Clear
        </button>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="alert alert-danger">
        @_errorMessage
    </div>
}

@if (_response is not null)
{
    <div class="card mb-4">
        <div class="card-header">
            Request Summary
        </div>

        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Success</dt>
                <dd class="col-sm-9">
                    @if (_response.Success)
                    {
                        <span class="badge bg-success">True</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">False</span>
                    }
                </dd>

                <dt class="col-sm-3">SQL Validated</dt>
                <dd class="col-sm-9">
                    @if (_response.SqlValidated)
                    {
                        <span class="badge bg-success">True</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">False</span>
                    }
                </dd>

                <dt class="col-sm-3">Query Executed</dt>
                <dd class="col-sm-9">
                    @if (_executeQuery)
                    {
                        <span class="badge bg-info text-dark">Requested</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Not Requested</span>
                    }
                </dd>

                <dt class="col-sm-3">Elapsed</dt>
                <dd class="col-sm-9">@_response.ElapsedMilliseconds ms</dd>

                <dt class="col-sm-3">Processed</dt>
                <dd class="col-sm-9">@_response.ProcessedUtc</dd>

                <dt class="col-sm-3">Row Count</dt>
                <dd class="col-sm-9">
                    @(_response.RowCount.HasValue
                        ? _response.RowCount.Value.ToString()
                        : "N/A")
                </dd>

                @if (!string.IsNullOrWhiteSpace(_response.ErrorMessage))
                {
                    <dt class="col-sm-3">Error</dt>
                    <dd class="col-sm-9 text-danger">
                        @_response.ErrorMessage
                    </dd>
                }
            </dl>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header">
            Generated SQL
        </div>

        <div class="card-body">
            <pre class="mb-0">@_response.GeneratedSql</pre>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_response.ResultJson))
    {
        <div class="card mb-4">
            <div class="card-header">
                Execution Result JSON
            </div>

            <div class="card-body">
                <pre style="white-space: pre-wrap;">@_response.ResultJson</pre>
            </div>
        </div>
    }

    <div class="card mb-4">
        <div class="card-header">
            Generated Prompt
        </div>

        <div class="card-body">
            <pre style="white-space: pre-wrap;">@_response.GeneratedPrompt</pre>
        </div>
    </div>
}

@code
{
    private string _userQuestion = string.Empty;
    private string _templateName = string.Empty;

    private bool _executeQuery;
    private bool _isLoading;

    private string _errorMessage = string.Empty;

    private QueryResponse? _response;

    private async Task GenerateAsync()
    {
        try
        {
            _isLoading = true;
            _errorMessage = string.Empty;
            _response = null;

            if (string.IsNullOrWhiteSpace(_userQuestion))
            {
                _errorMessage = "User Question is required.";
                return;
            }

            var request = new QueryRequest
            {
                UserQuestion = _userQuestion.Trim(),
                TemplateName = string.IsNullOrWhiteSpace(_templateName)
                    ? null
                    : _templateName.Trim(),
                ExecuteQuery = _executeQuery
            };

            _response =
                await QueryGenerationService.GenerateQueryAsync(
                    request);

            if (!_response.Success)
            {
                _errorMessage =
                    _response.ErrorMessage ??
                    "An unknown error occurred.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private Task ClearAsync()
    {
        _userQuestion = string.Empty;
        _templateName = string.Empty;
        _executeQuery = false;
        _errorMessage = string.Empty;
        _response = null;

        return Task.CompletedTask;
    }
}