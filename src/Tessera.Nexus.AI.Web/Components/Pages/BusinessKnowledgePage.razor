@page "/business-knowledge"

@using Tessera.Nexus.AI.Domain.Entities
@using Tessera.Nexus.AI.Application.Contracts

@inject IBusinessKnowledgeRepository Repository

<PageTitle>Business Knowledge</PageTitle>

<h3>Business Knowledge</h3>

@if (_knowledgeItems is null)
{
    <p>Loading...</p>
}
else if (!_knowledgeItems.Any())
{
    <div class="alert alert-info">
        No Business Knowledge records found.
    </div>
}
else
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Title</th>
                <th>Type</th>
                <th>Domain</th>
                <th>Priority</th>
                <th>Term</th>
                <th>Active</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in _knowledgeItems)
            {
                <tr>
                    <td>@item.KnowledgeTitle</td>
                    <td>@item.KnowledgeType</td>
                    <td>@item.SemanticDomain</td>
                    <td>@item.Priority</td>
                    <td>@item.AppliesToTerm</td>
                    <td>
                        @if (item.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactive</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <hr />

    <h4>Knowledge Details</h4>

    @foreach (var item in _knowledgeItems)
    {
        <div class="card mb-3">
            <div class="card-header">
                <strong>@item.KnowledgeTitle</strong>
            </div>

            <div class="card-body">

                <div class="row mb-2">
                    <div class="col-md-3">
                        <strong>Type</strong>
                    </div>
                    <div class="col-md-9">
                        @item.KnowledgeType
                    </div>
                </div>

                <div class="row mb-2">
                    <div class="col-md-3">
                        <strong>Domain</strong>
                    </div>
                    <div class="col-md-9">
                        @item.SemanticDomain
                    </div>
                </div>

                <div class="row mb-2">
                    <div class="col-md-3">
                        <strong>Company</strong>
                    </div>
                    <div class="col-md-9">
                        @item.Company
                    </div>
                </div>

                <div class="row mb-2">
                    <div class="col-md-3">
                        <strong>Plant</strong>
                    </div>
                    <div class="col-md-9">
                        @item.Plant
                    </div>
                </div>

                <div class="row mb-2">
                    <div class="col-md-3">
                        <strong>Applies To Term</strong>
                    </div>
                    <div class="col-md-9">
                        @item.AppliesToTerm
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-3">
                        <strong>Priority</strong>
                    </div>
                    <div class="col-md-9">
                        @item.Priority
                    </div>
                </div>

                <div class="mb-3">
                    <strong>Knowledge Text</strong>
                </div>

                <div class="bg-light border rounded p-3 mb-3">
                    @item.KnowledgeText
                </div>

                @if (!string.IsNullOrWhiteSpace(item.PromptInstruction))
                {
                    <div class="mb-3">
                        <strong>Prompt Instruction</strong>
                    </div>

                    <div class="bg-warning-subtle border rounded p-3">
                        @item.PromptInstruction
                    </div>
                }

            </div>
        </div>
    }
}
@code
{
    private IReadOnlyList<BusinessKnowledge>? _knowledgeItems;

    protected override async Task OnInitializedAsync()
    {
        _knowledgeItems =
            await Repository.GetActiveAsync();
    }
}